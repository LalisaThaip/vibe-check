# Azure Blob Storage (optional - falls back to local temp files)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=vibe-check-videos

# Azure AI Face API (optional - falls back to MediaPipe)
EMOTION_PROVIDER=azure
AZURE_FACE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_FACE_KEY=your-api-key-here
